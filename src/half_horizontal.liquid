<div class="layout layout--row layout--center gap--large">
  {% if has_value %}
    <div class="flex flex--col gap--xsmall w--[66cqw] portrait:w--full">
      <span class="title lg:title--xlarge" data-clamp="1">{{ heading }}</span>
      <div class="w--[56cqw] portrait:w--[85cqw]">
        <span class="value value--xxlarge lg:value--mega value--tnums" data-value-fit="true">{{ value_full }}</span>
      </div>
      <span class="label label--small lg:label--large" data-clamp="1">{{ subline }}</span>
    </div>
    <div class="flex flex--col gap--small portrait:hidden">
      {% if f1_value != '' %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--xsmall lg:value--base value--tnums">{{ f1_value }}</span>
            <span class="label label--small lg:label--base">{{ f1_label }}</span>
          </div>
        </div>
      {% endif %}
      {% if f2_value != '' %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--xsmall lg:value--base value--tnums">{{ f2_value }}</span>
            <span class="label label--small lg:label--base">{{ f2_label }}</span>
          </div>
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="flex flex--col gap--xsmall grow">
      <span class="title title--small" data-clamp="1">{{ heading | default: 'Home Value Estimate' }}</span>
      <span class="description" data-clamp="2">{{ error_text }}</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image" src="{{ house_icon }}" />
  <span class="title">Home Value</span>
  <span class="instance">Zillow ZHVI · {{ updated }}</span>
</div>
