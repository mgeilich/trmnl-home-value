<div class="layout layout--col layout--center gap--medium">
  {% if has_value %}
    <div class="flex flex--col flex--center-x gap--xsmall w--full">
      <span class="title text--center lg:title--xlarge" data-clamp="2">{{ short_heading }}</span>
      <div class="w--[85cqw] text--center">
        <span class="value value--xxlarge lg:value--mega value--tnums" data-value-fit="true">{{ value_full }}</span>
      </div>
      <span class="label label--small lg:label--large" data-clamp="1">{{ subline_short }}</span>
    </div>
    <div class="grid grid--cols-2 gap--small w--full">
      {% if f1_value != '' %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--xsmall lg:value--small value--tnums">{{ f1_value }}</span>
            <span class="label label--small lg:label--base">{{ f1_label }}</span>
          </div>
        </div>
      {% endif %}
      {% if f2_value != '' %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--xsmall lg:value--small value--tnums">{{ f2_value }}</span>
            <span class="label label--small lg:label--base">{{ f2_label }}</span>
          </div>
        </div>
      {% endif %}
      {% if f3_value != '' %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--xsmall lg:value--small value--tnums">{{ f3_value }}</span>
            <span class="label label--small lg:label--base">{{ f3_label }}</span>
          </div>
        </div>
      {% endif %}
      {% if f4_value != '' %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--xsmall lg:value--small value--tnums">{{ f4_value }}</span>
            <span class="label label--small lg:label--base">{{ f4_label }}</span>
          </div>
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="flex flex--col flex--center-x gap--small w--full">
      <span class="title title--small text--center" data-clamp="2">{{ short_heading | default: 'Home Value Estimate' }}</span>
      <span class="description text--center" data-clamp="5">{{ error_text }}</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image" src="{{ house_icon }}" />
  <span class="title">Home Value</span>
  <span class="instance">Zillow ZHVI</span>
</div>
